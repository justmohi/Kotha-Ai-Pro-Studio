rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all writes & reads
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'mohistudio95@gmail.com';
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.tier in ['free', 'basic', 'plus', 'pro'] &&
             data.monthlyLimit is int &&
             data.maxDurationSeconds is int &&
             data.creditsUsed is int && data.creditsUsed >= 0;
    }

    function isValidTransaction(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.tier in ['basic', 'plus', 'pro'] &&
             data.amount is number && data.amount >= 0 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.provider is string && data.provider.size() <= 32 &&
             data.status in ['pending', 'completed', 'failed'];
    }

    function isValidPaymentRequest(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 256 &&
             data.tier in ['basic', 'plus', 'pro'] &&
             data.method in ['bKash', 'Binance Pay'] &&
             data.trxId is string && data.trxId.size() <= 128 &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) && isValidUser(incoming())) || isAdmin();
      allow delete: if isAdmin();

      match /transactions/{transactionId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) && isValidId(transactionId) && isValidTransaction(incoming());
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /payment_requests/{requestId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(requestId) && isValidPaymentRequest(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
